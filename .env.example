# Copie para .env e preencha. NUNCA commite o .env.
# Banco (docker compose sobe um Postgres local com estes valores)
DATABASE_URL="postgresql://fabrica:DB_PASSWORD@localhost:5432/fabrica_magica?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth (Sprint 1 - API)
JWT_SECRET="SECRET_KEY_AQUI"
JWT_REFRESH_SECRET="SECRET_KEY_AQUI"

# Mercado Pago (Sprint 5)
MERCADOPAGO_ACCESS_TOKEN="TOKEN_AQUI"
MERCADOPAGO_WEBHOOK_SECRET="SECRET_KEY_AQUI"

# Documentos sensíveis (Sprint 4) - só usados se hostSensitiveDocs = true
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_BUCKET="fabrica-docs"
S3_ACCESS_KEY_ID="API_KEY_AQUI"
S3_SECRET_ACCESS_KEY="SECRET_KEY_AQUI"
DOCS_ENCRYPTION_KEY="CHAVE_AES256_BASE64_AQUI"

# Observabilidade
SENTRY_DSN=""
LOGTAIL_TOKEN="TOKEN_AQUI"
