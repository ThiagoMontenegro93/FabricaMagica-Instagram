# Copie para .env e preencha. NUNCA commite o .env.
# Banco (docker compose sobe um Postgres local com estes valores)
DATABASE_URL="postgresql://fabrica:DB_PASSWORD@localhost:5432/fabrica_magica?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth (Sprint 1). Gere com: openssl rand -base64 48
JWT_SECRET="SECRET_KEY_AQUI_MINIMO_32_CARACTERES"

# Tenant e origem pública (anti-CSRF)
TENANT_SLUG="afabricamagica"
APP_ORIGIN="http://localhost:3000"

# Dono do sistema (SUPER_ADMIN), criado pelo pnpm db:seed. Senha com 12+ caracteres.
ADMIN_EMAIL="dono@exemplo.com"
ADMIN_PASSWORD="SENHA_FORTE_AQUI"

# Mercado Pago: Pix + cartão (Checkout Pro). Pegue em mercadopago.com.br/developers > Suas integrações.
# Webhook: cadastre https://SEU_DOMINIO/api/payments/webhook (evento "Pagamentos") e copie a "assinatura secreta".
# Sem token, o site cai no WhatsApp. PAYMENTS_SIMULATOR=1 libera um botão de teste (nunca em produção).
MERCADOPAGO_ACCESS_TOKEN="TOKEN_AQUI"
MERCADOPAGO_WEBHOOK_SECRET="SECRET_KEY_AQUI"
PAYMENTS_SIMULATOR="0"

# Mídias do catálogo (fotos, vídeo curto, GIF).
# local = grava em UPLOAD_DIR (dev/VPS). s3 = Cloudflare R2/AWS S3 (Railway/Render, disco efêmero).
STORAGE_DRIVER="local"
UPLOAD_DIR="./.uploads"
S3_REGION="auto"
S3_MEDIA_BUCKET="fabrica-midia"
S3_MEDIA_PUBLIC_URL="https://midia.SEU_DOMINIO_AQUI"

# Documentos sensíveis (Sprint 4) - só usados se hostSensitiveDocs = true
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_BUCKET="fabrica-docs"
S3_ACCESS_KEY_ID="API_KEY_AQUI"
S3_SECRET_ACCESS_KEY="SECRET_KEY_AQUI"
# Gere com: openssl rand -base64 32  (sem ela, o upload de documentos fica desligado)
DOCS_ENCRYPTION_KEY="CHAVE_AES256_BASE64_AQUI"
# Pasta privada dos documentos no modo local (fora da pasta pública de mídia)
DOCS_DIR="./.private-docs"
# Segredo da rotina agendada POST /api/cron/rotina (Authorization: Bearer ...)
CRON_SECRET="SECRET_KEY_AQUI"

# Observabilidade
SENTRY_DSN=""
LOGTAIL_TOKEN="TOKEN_AQUI"
