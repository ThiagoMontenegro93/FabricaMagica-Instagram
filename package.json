{
  "name": "fabrica-magica",
  "private": true,
  "description": "A Fábrica Mágica - Sistema de Locação Premium. Alugue o Medo. Celebre o Luxo.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @fabrica/db generate",
    "db:migrate": "pnpm --filter @fabrica/db migrate:dev",
    "db:deploy": "pnpm --filter @fabrica/db migrate:deploy",
    "db:seed": "pnpm --filter @fabrica/db seed"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
